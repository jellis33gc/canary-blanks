{
  "name": "Send Scheduled Campaigns",
  "description": "Runs the sendCampaign backend function every 2 hours with mode: scheduled_scan to process scheduled campaigns.",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "interval",
      "cron_expression": null,
      "one_time_date": null,
      "timezone": "UTC",
      "interval_value": 2,
      "interval_unit": "hours",
      "interval_anchor": "2026-07-12T17:53:59.826000",
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "send_scheduled_campaigns",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "sendCampaign",
            "args": {
              "mode": "scheduled_scan"
            }
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "sendCampaign"
  }
}